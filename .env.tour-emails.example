# Use these alongside an isolated preview Supabase project configuration.
TOUR_MANAGEMENT_ENABLED=false

# Disabled mode saves email jobs and allows staff previews without contacting Resend.
TOUR_EMAIL_MODE=disabled

# Required only when deliberately enabling test or send mode.
TOUR_EMAIL_API_KEY=
TOUR_EMAIL_FROM=

# Test mode redirects every email to this inbox, including branch notifications.
TOUR_EMAIL_TEST_RECIPIENT=

# Protects POST /api/tour-emails for the scheduled retry worker.
TOUR_EMAIL_CRON_SECRET=
